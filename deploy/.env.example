# Copy the relevant vars into backend/.env (backend) and/or the project-root .env
# (compose build-arg substitution). None of these are committed.

# ── backend/.env (read by the Django container) ──────────────────────────────
# Chat (already set when you fixed the chat box):
# ANTHROPIC_API_KEY=sk-ant-...
#
# Generate a fresh production Django secret. Do not reuse the development default:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=change-me
#
# DJANGO_DEBUG / DJANGO_ALLOWED_HOSTS / DJANGO_CSRF_TRUSTED_ORIGINS are set by
# docker-compose.yml (prod) and docker-compose.dev.yml (local); override here only
# if you need to.

# ── project-root .env (compose build-arg substitution for the frontend) ──────
# DRF token baked into the SPA bundle. This is public because it is client-side JavaScript:
# VITE_API_TOKEN=
